# 生成至少 32 字节随机值并进行 Base64URL 编码，禁止提交真实值。
LICENSE_HMAC_SECRET_B64=replace-with-strong-random-secret

# Ed25519 原始 32 字节私钥的 Base64URL 编码，禁止提交真实值。
LICENSE_SIGNING_PRIVATE_KEY_B64=replace-with-ed25519-private-key

LICENSE_DATABASE_PATH=/home/ubuntu/ServerCode/VisonCube/data/licenses.db
LICENSE_AUTH_ME_URL=http://127.0.0.1:8088/api/auth/me
LICENSE_ADMIN_USERNAME=3298003230
# 首次确认正式账户的不可变用户 ID 后必须填写，避免只依赖可见用户名。
LICENSE_ADMIN_USER_ID=
LICENSE_LEASE_SECONDS=900
LICENSE_AUTH_TIMEOUT_SECONDS=5
